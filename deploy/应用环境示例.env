# Copy outside the public checkout and chmod 600. Never commit real values.
DB_URL=jdbc:postgresql://database.internal:5432/learning?sslmode=verify-full
DB_USER=learning_app
DB_PASSWORD=REPLACE
# The Web process starts only AFTER a separately authorized migration completes.
SPRING_FLYWAY_ENABLED=false
# DB_MIGRATION_USER / DB_MIGRATION_PASSWORD belong only in a separate one-time
# migration environment file, never in this Web environment or its container.
OIDC_CLIENT_ID=learning
OIDC_CLIENT_SECRET=REPLACE
OIDC_ISSUER=https://identity.example/realms/example
REGISTRATION_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
REGISTRATION_REDIRECT_URI=https://learning.example/edu/math/login/oauth2/code/learning
OPERATOR_ISSUER=https://identity.example/realms/example
OPERATOR_SUBJECT=REPLACE_WITH_VERIFIED_IMMUTABLE_SUBJECT

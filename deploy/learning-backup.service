[Unit]
Description=Protected learning database snapshot
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
UMask=0077
EnvironmentFile=/etc/learning/operations.env
ExecStart=/usr/bin/python3 /opt/learning/ops/backup.py
Nice=10
NoNewPrivileges=true
PrivateTmp=true
